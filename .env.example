# Warehouse Pro Mobile — Environment Variables
# Copy this file to .env.local and fill in the values

# API URL (default: https://api.warehousepro.uz)
EXPO_PUBLIC_API_URL=

# Yandex Maps API Key (required for map features)
# Get yours at https://developer.yandex.com/maps/
# Ключ Яндекс.Карт для экрана слежения за агентами.
# Для сборок EAS значение берётся НЕ отсюда: оно лежит переменной окружения
# проекта в EAS (eas env:list). Railway тут ни при чём — там живёт бэкенд, а
# APK собирает EAS, и переменные он берёт из своего хранилища или из eas.json.
# Этот файл нужен для локального expo start: скопируйте его в .env и впишите ключ.
# Проверить ключ можно так — в ответе должно быть "apikeyValid":true:
#   curl -s "https://api-maps.yandex.ru/2.1/?apikey=ВАШ_КЛЮЧ" | grep -o 'apikeyValid":[a-z]*'
EXPO_PUBLIC_YANDEX_MAPS_API_KEY=
